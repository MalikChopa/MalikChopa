{
	admin off
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}
live.@DOMAIN@ {
	@api path /stream /now.json /sol.json /health
	handle @api {
		reverse_proxy 127.0.0.1:4180 {
			flush_interval -1
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond 404
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
