#!/usr/bin/env bash
# sol0ctl: operator commands (root). Messages in French; the command to type is always given.
set -euo pipefail
ROOT="${SOL0_ROOT:-}"
TOKEN_DIR="$ROOT/var/lib/sol0/secret"
TOKEN_FILE="$TOKEN_DIR/github-token"
IDENT_FILE="$TOKEN_DIR/identity"
CONF="$ROOT/etc/sol0/live.toml"
DATA="$ROOT/var/lib/sol0"
KITDIR="$(dirname "$(readlink -f "$0")")"
HOLD="$ROOT/etc/systemd/system/rover-live.service.d/00-hold-until-golive.conf"

die() { echo "$*" >&2; exit 1; }
need_root() { [ -n "$ROOT" ] || [ "$(id -u)" = 0 ] || die "À lancer en root : sudo sol0ctl $*"; }

token_set() {
  [ -t 0 ] || [ -n "${SOL0_TOKEN_FROM_STDIN:-}" ] || die "Lancer dans un terminal : sol0ctl token set"
  local tok
  printf 'Coller le jeton GitHub (rien ne s affiche) : ' >&2
  IFS= read -rs tok; printf '\n' >&2
  [[ "$tok" =~ ^github_pat_[A-Za-z0-9_]{20,}$ ]] || die "Jeton refusé : seul un jeton à grain fin (github_pat_…) limité à un dépôt est accepté (pas un jeton classique ghp_). Rien écrit."
  mkdir -p "$TOKEN_DIR"; chmod 0700 "$TOKEN_DIR"
  ( umask 077; printf '%s' "$tok" > "$TOKEN_FILE.new" )
  chmod 0600 "$TOKEN_FILE.new"; mv -f "$TOKEN_FILE.new" "$TOKEN_FILE"
  [ -n "$ROOT" ] || chown sol0:sol0 "$TOKEN_DIR" "$TOKEN_FILE"
  if [ -z "${SOL0_NO_NETWORK:-}" ]; then
    # identity = owner's noreply address read from GET /user; token passed through a 0600 header file, never argv
    local hdr; hdr="$(mktemp)"; chmod 0600 "$hdr"
    printf 'Authorization: Bearer %s\n' "$tok" > "$hdr"
    local js; js="$(curl -fsS -m 20 -H @"$hdr" -H 'Accept: application/vnd.github+json' https://api.github.com/user || true)"
    rm -f "$hdr"
    local id login
    id="$(printf '%s' "$js" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("id",""))' 2>/dev/null || true)"
    login="$(printf '%s' "$js" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("login",""))' 2>/dev/null || true)"
    if [[ "$id" =~ ^[0-9]+$ ]] && [[ "$login" =~ ^[A-Za-z0-9-]+$ ]]; then
      ( umask 077; printf '%s+%s@users.noreply.github.com\n' "$id" "$login" > "$IDENT_FILE" )
      [ -n "$ROOT" ] || chown sol0:sol0 "$IDENT_FILE"
      echo "Identité de publication enregistrée (adresse noreply du propriétaire)."
    else
      echo "Identité non lue (réseau ou jeton) : relancer sol0ctl token set." >&2
    fi
  fi
  unset tok
  echo "Jeton enregistré (0600). Date d'expiration : à noter dans /etc/sol0/live.toml (token_expires)."
}

token_check() {
  [ -f "$TOKEN_FILE" ] || die "Pas de jeton. Commande : sudo sol0ctl token set"
  local m; m="$(stat -c '%a' "$TOKEN_FILE" 2>/dev/null || stat -f '%Lp' "$TOKEN_FILE")"
  [ "$m" = 600 ] || die "Droits du jeton : $m au lieu de 600. Commande : sudo chmod 600 $TOKEN_FILE"
  echo "Jeton présent, droits 600."
  [ -s "$IDENT_FILE" ] && echo "Identité : présente." || echo "Identité : absente (sol0ctl token set)."
}

# birth --at <UTC ISO> : the ONLY way to release the held engine (birth safety). Run by the owner of the go-live, with the user's go.
birth() {
  [ "${1:-}" = "--at" ] && [ -n "${2:-}" ] || die "usage: sudo sol0ctl birth --at AAAA-MM-JJTHH:MM:SSZ   (instant UTC de la naissance, proche de maintenant)"
  local at="$2"
  [[ "$at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || die "Date invalide : format AAAA-MM-JJTHH:MM:SSZ (UTC). Rien fait."
  [ -e "$DATA/live/birth.json" ] && die "Déjà né ($DATA/live/birth.json existe) : refus. Rien fait."
  "$KITDIR/ntp_check.sh" || die "Horloge non synchronisée : naissance refusée. Voir : timedatectl status. Rien fait."
  local app="${SOL0_APP:-/opt/sol0/app}" py="${SOL0_PY:-/opt/sol0/venv/bin/python}" now="${SOL0_NOW_EPOCH:-$(date -u +%s)}"
  local run=(); [ -n "$ROOT" ] || run=(runuser -u sol0 --)
  ${run[@]+"${run[@]}"} "$py" -c '
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1] + "/src")
from rover.live import birth, schedule
t = schedule.parse_iso(sys.argv[3]); now = int(sys.argv[4])
if not (-300 <= t - now <= 3600):
    sys.exit("birth: --at must be within 5 min in the past and 1 h in the future of the server clock")
rec = birth.ensure_birth(Path(sys.argv[2]), t)
print("birth: %s seed %s" % (rec["birth_utc"], rec["birth_seed"]))
' "$app" "$DATA/live" "$at" "$now" || die "Naissance non enregistrée : le moteur reste retenu."
  rm -f "$HOLD"
  if [ -z "$ROOT" ]; then systemctl daemon-reload; systemctl start rover-live; fi
  echo "Moteur libéré. Suivi : sol0ctl status ; journal : sol0ctl logs"
}

status() {
  echo "== Services"
  for u in rover-live rover-web caddy; do
    printf '%s : %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || echo inconnu)"
  done
  if [ -e "$HOLD" ]; then echo "Moteur : RETENU jusqu'à la naissance (sudo sol0ctl birth --at AAAA-MM-JJTHH:MM:SSZ)"; fi
  "$KITDIR/ntp_check.sh" 2>&1 && echo "Horloge : synchronisée" || true
  echo "== Santé"
  "$(dirname "$(readlink -f "$0")")/healthcheck.sh" || echo "Cause : voir 'sol0ctl logs'. Si 'publish' : sol0ctl token check ; si 'hold' : lire le détail dans $DATA/live/health.json."
  [ -f "$DATA/live/health.json" ] && cat "$DATA/live/health.json" || true
}

case "${1:-}" in
  token)
    need_root "$@"
    case "${2:-}" in set) token_set ;; check) token_check ;; *) die "usage: sol0ctl token set|check" ;; esac ;;
  status) status ;;
  birth) need_root "$@"; shift; birth "$@" ;;
  start) need_root "$@"
         if [ -e "$HOLD" ]; then echo "Moteur retenu jusqu'à la naissance (sol0ctl birth --at …) : seul le web est démarré."; systemctl start rover-web
         else systemctl start rover-live rover-web; fi ;;
  stop) need_root "$@"; systemctl stop rover-live rover-web ;;
  logs) journalctl -u rover-live -u rover-web -n 200 --no-pager ;;
  verify) need_root "$@"; [ -n "${2:-}" ] || die "usage: sol0ctl verify SOL"
          cd /opt/sol0/app && sudo -u sol0 env PYTHONPATH=src /opt/sol0/venv/bin/python -m rover live verify "$2" ;;
  update|rollback-release|adopt-remote|force-local|restore)
    die "sol0ctl $1 : fourni avec L4/L5 (dépend de la reprise du moteur, voir docs/milestones/L3A-contract.md)" ;;
  *) die "usage: sol0ctl status|start|stop|logs|token set|check|birth --at ISO|verify SOL" ;;
esac
